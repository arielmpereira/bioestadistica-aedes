# Una lista puede contener elementos de cualquier tipo y tamaño
registro <- list(
id         = 101,
nombre     = "Valentina López",
notas      = c(8.5, 7.0, 9.5, 8.0, 7.5),
aprobado   = TRUE,
materias   = c("Estadística", "Cálculo", "Programación",
"Álgebra", "Bases de Datos"),
direccion  = list(ciudad = "San Luis", cp = "5700")
)
# --- ESTRUCTURA ---
str(registro)        # vista compacta de toda la lista
length(registro)     # cantidad de elementos de primer nivel
names(registro)      # nombres de los elementos
# --- ESTRUCTURA ---
str(registro)        # vista compacta de toda la lista
length(registro)     # cantidad de elementos de primer nivel
names(registro)      # nombres de los elementos
registro$nombre
registro[["notas"]]
registro[[3]]
# Diferencia clave entre [] y [[]]
class(registro[3])
class(registro[[3]])
registro[3]
registro[[3]]
registro[3]
# Diferencia clave entre [] y [[]]
class(registro[3])
class(registro[[3]])
# Acceso anidado: lista dentro de lista
registro$direccion$ciudad
registro[["direccion"]][["cp"]]
