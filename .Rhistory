library(e1071)
install.packages("e1071")
library(e1071)
set.seed(123)
x <- c(rnorm(100, mean = 2), rnorm(100, mean = 8))
g1_x <- skewness(x)
g1_x
hist(x, breaks = 20, main = "Datos bimodales", col = "gray80")
qqnorm(x); qqline(x, col = "red")
shapiro.test(x)
hist(x, breaks = 20, main = "Datos bimodales", col = "gray80")
qqnorm(x); qqline(x, col = "red")
hist(x, breaks = 20, col = "gray80")
hist(x, breaks = 20)
r <- grafico_transformacion(x, "Datos bimodales - gráfico de transformación")
r
r <- grafico_transformacion(x, "Datos bimodales - gráfico de transformación")
l <- M - x[m:1]
grafico_transformacion <- function(x, main = "Gráfico de transformación") {
x <- sort(x[!is.na(x)])
n <- length(x)
M <- median(x)
m <- floor(n / 2)
if (n %% 2 == 0) {
u <- rev(x[(m + 1):n]) - M
l <- M - x[m:1]
} else {
u <- rev(x[(m + 1):n]) - M
l <- M - x[m:1]
}
k <- min(length(u), length(l))
u <- u[1:k]
l <- l[1:k]
f <- (u + l) / 2
d <- (u - l) / 2
plot(
f, d,
pch = 19,
col = "steelblue",
xlab = "Medio-spread (u+l)/2",
ylab = "Semi-diferencia (u-l)/2",
main = main
)
abline(h = 0, lty = 2, col = "gray60")
ajuste <- lm(d ~ f)
abline(ajuste, col = "red", lwd = 2)
b <- coef(ajuste)[2]
p_sug <- 1 - b
legend(
"topleft",
bty = "n",
legend = c(
paste("b =", round(b, 3)),
paste("p sugerido =", round(p_sug, 3))
)
)
invisible(list(b = b, p_sug = p_sug))
}
r <- grafico_transformacion(x, "Datos bimodales - gráfico de transformación")
r
x_log_shift <- log(x + abs(min(x)) + 1)
# log(x) solo si todos los valores son positivos
all(x > 0)
x_log <- log(x)
x11()
par(mfrow = c(1, 3))
hist(x, breaks = 20, main = "Original", col = "gray80")
hist(x_log_shift, breaks = 20, main = "log(x + |min| + 1)", col = "gray80")
hist(x_log, breaks = 20, main = "log(x)", col = "gray80")
x11()
par(mfrow = c(3, 1))
hist(x, breaks = 20, main = "Original", col = "gray80")
hist(x_log_shift, breaks = 20, main = "log(x + |min| + 1)", col = "gray80")
hist(x_log, breaks = 20, main = "log(x)", col = "gray80")
skewness(x)
