library(DiagrammeR)
grViz("
digraph flujo {
graph [layout = dot, rankdir = TB]
node [shape = box,
style = rounded,
fontsize = 12]
A [label = '1. Filtrado de datos y selección de variables\\nGrid_type = Index\\nlog volume > 0']
B [label = '2. Evaluación de ceros']
C [label = '3. Evaluación de sobredispersión\\ne inflación de ceros']
D [label = '4. Comparación de familias\\nPoisson / NB / ZINB\\nSelección de ZINB']
E [label = '5. Comparación de estructuras ZINB']
E1 [label = 'Modelo base']
E2 [label = '+ Macrohabitat']
E3 [label = '+ Microhabitat']
F [label = 'Elegir modelo candidato']
G [label = '6. Simplificación de covariables']
H [label = '7. Diagnóstico con DHARMa']
I [label = '8. Interpretación del modelo final']
A -> B -> C -> D -> E
E -> E1 -> F
E -> E2 -> F
E -> E3 -> F
F -> G -> H -> I
}
")
